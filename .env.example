# Copy to .env and fill in. Never commit .env.

# Web and worker. Required.
DATABASE_URL=postgres://localhost/recomphub

# Public origin used in canonical URLs, sitemaps, feeds, JSON-LD and OAuth callbacks.
SITE_URL=http://localhost:8080

# Where AVIF and og JPEG files are written. Default: ./data/media
MEDIA_DIR=./data/media

# Google OAuth client (Web application) for sign-in, the only sign-in method. Authorized
# redirect URI: ${SITE_URL}/auth/google/callback. Without these, /auth/google returns 503.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated emails granted the admin role when they sign in with Google and Google
# reports the email as verified.
ADMIN_EMAILS=

# Optional. Raises GitHub API rate limits for repo previews on /submit (web) and worker github-sync, discover, import-recompendium.
GITHUB_TOKEN=

# IGDB (Twitch application). Required by worker catalog-sync and imports, and by web moderation approve-with-IGDB, IGDB search and new-game submissions.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API key. Required by worker youtube-sync.
YOUTUBE_API_KEY=

# Encrypts AI provider credentials stored from /admin. 32 bytes, base64: openssl rand -base64 32
# Without it, providers can't be saved, and describe-ports and describe-games skip with a warning.
SECRETS_KEY=

# Discord bot token for `cargo run -p recomphub-worker --bin discord-setup`.
# Create it in Discord's Developer Portal; never commit or share this value.
DISCORD_BOT_TOKEN=
