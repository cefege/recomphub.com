# Copy to .env and fill in. Never commit .env.

# Web and worker. Required.
DATABASE_URL=postgres://localhost/recomphub

# Public origin used in canonical URLs, sitemaps, feeds and JSON-LD.
SITE_URL=http://localhost:8080

# Where AVIF and og JPEG files are written. Default: ./data/media
MEDIA_DIR=./data/media

# Comma-separated GitHub logins granted the admin role on sign-in.
ADMIN_GITHUB_LOGINS=

# GitHub OAuth app for sign-in. Without these, /auth/github/login returns 503.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional. Comma-separated Google account emails granted the admin role on sign-in. Only verified emails count.
ADMIN_GOOGLE_EMAILS=

# Google OAuth client for sign-in (type: Web application). Without these, /auth/google/login returns 503.
# Redirect URI: {SITE_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional. Raises GitHub API rate limits for repo previews on /submit (web) and worker github-sync, discover, import-recompendium.
GITHUB_TOKEN=

# IGDB (Twitch application). Required by worker catalog-sync and imports, and by web moderation approve-with-IGDB, IGDB search and new-game submissions.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API key. Required by worker youtube-sync.
YOUTUBE_API_KEY=

# Anthropic API key. Required by worker describe-ports; without it the job logs and exits.
ANTHROPIC_API_KEY=

# Optional. Model for describe-ports. Default: claude-haiku-5-5
DESCRIPTION_MODEL=
