# Copy to .env and fill in. Never commit .env.

# Web and worker. Required.
DATABASE_URL=postgres://localhost/recomphub

# Public origin used in canonical URLs, sitemaps, feeds, JSON-LD and OAuth callbacks.
SITE_URL=http://localhost:8080

# Where AVIF and og JPEG files are written. Default: ./data/media
MEDIA_DIR=./data/media

# GitHub OAuth app for member sign-in. Callback URL: ${SITE_URL}/auth/github/callback.
# Without these, /auth/github returns 503.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Comma-separated emails granted the admin role. Admin is granted only through Cloudflare
# Access (/auth/cloudflare), never through GitHub, and only for the verified Access email.
ADMIN_EMAILS=

# Cloudflare Access application protecting /auth/cloudflare. Without these, /auth/cloudflare returns 503.
# CF_ACCESS_TEAM_DOMAIN: the team domain, for example team.cloudflareaccess.com (no scheme).
# CF_ACCESS_AUD: the application audience tag from the Access application's overview page.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional. Raises GitHub API rate limits for repo previews on /submit (web) and worker github-sync, discover, import-recompendium.
GITHUB_TOKEN=

# IGDB (Twitch application). Required by worker catalog-sync and imports, and by web moderation approve-with-IGDB, IGDB search and new-game submissions.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API key. Required by worker youtube-sync.
YOUTUBE_API_KEY=

# Encrypts AI provider credentials stored from /admin. 32 bytes, base64: openssl rand -base64 32
# Web and workers must share it. Without it, providers can't be saved and describe-ports exits.
SECRETS_KEY=
