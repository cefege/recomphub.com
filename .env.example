# Copy to .env and fill in. Never commit .env.

# Web and worker. Required.
DATABASE_URL=postgres://localhost/recomphub

# Public origin used in canonical URLs, sitemaps, feeds, JSON-LD and OAuth callbacks.
SITE_URL=http://localhost:8080

# Where AVIF and og JPEG files are written. Default: ./data/media
MEDIA_DIR=./data/media

# Google OAuth client (Web application) for sign-in. Authorized redirect URI:
# ${SITE_URL}/auth/google/callback. Without these, the sign-in page has no Google button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional GitHub OAuth app for sign-in. Callback URL: ${SITE_URL}/auth/github/callback.
# Without these, the sign-in page has no GitHub button.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Comma-separated emails granted the admin role when they sign in with Google and Google
# reports the email as verified. GitHub sign-in never grants admin.
ADMIN_EMAILS=

# Optional Cloudflare Access application protecting /auth/cloudflare, a second admin sign-in
# path for the same ADMIN_EMAILS. Without these, /auth/cloudflare returns 503.
# CF_ACCESS_TEAM_DOMAIN: the team domain, for example team.cloudflareaccess.com (no scheme).
# CF_ACCESS_AUD: the application audience tag from the Access application's overview page.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional. Raises GitHub API rate limits for repo previews on /submit (web) and worker github-sync, discover, import-recompendium.
GITHUB_TOKEN=

# IGDB (Twitch application). Required by worker catalog-sync and imports, and by web moderation approve-with-IGDB, IGDB search and new-game submissions.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API key. Required by worker youtube-sync.
YOUTUBE_API_KEY=

# Encrypts AI provider credentials stored from /admin. 32 bytes, base64: openssl rand -base64 32
# Without it, providers can't be saved, and describe-ports and describe-games skip with a warning.
SECRETS_KEY=
